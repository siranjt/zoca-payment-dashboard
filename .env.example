# =============================================================================
# Zoca Payment Validator Dashboard — environment configuration
# Copy this file to .env.local for local dev, or `vercel env add` for deploy.
# =============================================================================

# --- Postgres ---------------------------------------------------------------
# Vercel Postgres connection string (auto-injected on `vercel env pull`).
# For local dev with Vercel Postgres: run `vercel env pull .env.development.local`
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Vercel Blob ------------------------------------------------------------
# Auto-injected on Vercel (no manual setup needed).
BLOB_READ_WRITE_TOKEN=

# --- Chargebee --------------------------------------------------------------
CHARGEBEE_SITE=zoca
CHARGEBEE_API_KEY=
# The shared secret you set when creating the webhook in Chargebee.
# We HMAC-verify every incoming webhook against this.
CHARGEBEE_WEBHOOK_SECRET=

# --- Stripe -----------------------------------------------------------------
STRIPE_API_KEY=

# --- Metabase ---------------------------------------------------------------
METABASE_API_KEY=

# --- Anthropic (LLM evaluator) ---------------------------------------------
# Generate an API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# --- Slack ------------------------------------------------------------------
SLACK_CHANNEL_ID=C0B2ECQMDR9
# OPTIONAL: Slack bot token with files:write + chat:write scope. If set, the
# pipeline uploads the .docx natively as a Slack file. If unset, the Slack
# message just includes a dashboard link.
SLACK_BOT_TOKEN=

# --- App config -------------------------------------------------------------
# Public-facing dashboard URL (used in Slack post). Auto-set by Vercel as
# https://${VERCEL_URL}.
NEXT_PUBLIC_APP_URL=
# Customer-creation floor — only customers created at/after this date are
# tracked. Format: YYYY-MM-DD (interpreted as 00:00 UTC).
CUSTOMER_FLOOR_DATE=2026-05-01
# Discovery filter pattern (case-insensitive substring match on item_price_id)
DISCOVERY_FILTER_PATTERN=discovery
# Comms lookback window (days)
COMMS_WINDOW_DAYS=90
# Mismatch threshold between Chargebee and Stripe customer-created (hours)
TIMESTAMP_MISMATCH_HOURS=24
